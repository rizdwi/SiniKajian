{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3",
      "includeFiles": "database/**"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "X-XSS-Protection": "1; mode=block",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
        "Permissions-Policy": "geolocation=(self), camera=(), microphone=(), payment=()"
      },
      "continue": true
    },
    {
      "src": "/(favicon\\.(ico|svg)|favicon-.*\\.png|apple-touch-icon.*\\.png|android-chrome-.*\\.png)",
      "dest": "/public/$1",
      "headers": {
        "Cache-Control": "public, max-age=604800, immutable"
      }
    },
    {
      "src": "/sw.js",
      "dest": "/public/sw.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0",
        "Content-Type": "application/javascript; charset=utf-8"
      }
    },
    {
      "src": "/manifest.json",
      "dest": "/public/manifest.json",
      "headers": {
        "Cache-Control": "public, max-age=3600, must-revalidate",
        "Content-Type": "application/manifest+json; charset=utf-8"
      }
    },
    {
      "src": "/images/(.*)",
      "dest": "/public/images/$1",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "src": "/js/(.*)",
      "dest": "/public/js/$1",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_NAME": "Majelisku",
    "APP_URL": "https://majelisku.web.id",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "CACHE_STORE": "database",
    "SESSION_DRIVER": "cookie",
    "SESSION_LIFETIME": "120",
    "SESSION_SECURE_COOKIE": "true",
    "SESSION_HTTP_ONLY": "true",
    "SESSION_SAME_SITE": "lax",
    "DB_CONNECTION": "sqlite",
    "DB_DATABASE": "/tmp/database.sqlite",
    "LOG_CHANNEL": "stderr",
    "MAIL_MAILER": "resend",
    "MAIL_FROM_ADDRESS": "noreply@majelisku.web.id",
    "MAIL_FROM_NAME": "Majelisku"
  }
}
